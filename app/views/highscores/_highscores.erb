<div id="entries">
  <% if highscores.any? %>
    <ol class="highscores-list">
      <% highscores.each do |user| %>
        <%= render partial: "highscores/highscore", locals: { user: user, alive_player_count: alive_player_count } %>
      <% end %>
    </ol>
  <% else %>
    <p>No players yet.</p>
  <% end %>
</div>