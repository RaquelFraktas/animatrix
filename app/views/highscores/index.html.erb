<div class="matrix-container">
  <canvas id="matrix-rain"></canvas>
  <div class="matrix-content">
    <div class="leaderboard">
      <span>LEADER_BOARD</span>
      <%= render "stats" %>
    </div>
    <div id="highscores" data-controller="scoreboard">
      <%= turbo_stream_from "highscores" %>
      <%= render "highscores", highscores: @highscores, alive_player_count: @alive_player_count %>
    </div>
  </div>
</div>
