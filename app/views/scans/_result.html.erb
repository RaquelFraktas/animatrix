<% if user.name.nil? %>
  <div>
    <h2>This QR code needs a name</h2>
    <% user.errors.full_messages_for(:name).each do |message| %>
      <p style="color: red;" data-controller="page-shake"><%= message %></p>
    <% end %>
    <%= form_with url: scan_path, method: :post do |form| %>
      <%= form.hidden_field :qr_code, value: user.qr_code %>
      <%= form.label :target_name, "Player name" %>
      <%= form.text_field :target_name, required: true, autofocus: true %>
      <%= form.submit "Save name", class: "btn matrix" %>
    <% end %>
  </div>
<% elsif user.killed? %>
  <h2><%= user.name %> is <span style="color: red; font-style: italic">dead</span></h2>
<% elsif current_user == user %>
  <h2>Player name: <%= user.name %></h2>
<% elsif user.alive? && current_user != user %>
  <div>
    <%= form_with url: scan_path, method: :post do |form| %>
      <%= form.hidden_field :qr_code, value: user.qr_code %>
      <%= form.submit "Free #{user.name}'s mind", class: "btn matrix" %>
    <% end %>
  </div>
<% end %>