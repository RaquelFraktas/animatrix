<dialog class="game-play-dialog"
	data-controller="game-play-modal"
	data-game-play-modal-reload-on-close-value="true"
	aria-labelledby="killed-notice-title">
  <button class="game-play-close"
	  type="button"
	  aria-label="Close"
	  data-action="game-play-modal#close">×</button>

  <h1 id="killed-notice-title" style="color: red;">YOU ARE FREED</h1>

  <p>GO TO THE OPERATOR AND GET A <span style="color: white;">GLOWSTICK NECKLACE</span></p>

  <p>WEAR IT SO OTHER PLAYERS KNOW YOU ARE OUT</p>
</dialog>
