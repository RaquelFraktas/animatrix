<nav class="qr-sheet-pagination" aria-label="QR code pages">
  <%= link_to "‹ Prev", qr_codes_path(page: @page - 1) if @page > 1 %>
  <% (1..@total_pages).each do |page| %>
    <% if page == @page %>
      <span aria-current="page"><%= page %></span>
    <% else %>
      <%= link_to page, qr_codes_path(page: page) %>
    <% end %>
  <% end %>
  <%= link_to "Next ›", qr_codes_path(page: @page + 1) if @page < @total_pages %>
</nav>
