<h1><%= @user.name %></h1>
<p>Status: <%= @user.status %></p>
<p>Kill count: <%= @user.kill_count %></p>
<p>QR code value: <%= @user.qr_code %></p>

<% if @user.qr_code.present? %>
  <div><%= sanitize(@user.qr_code_svg, tags: %w[svg path], attributes: %w[xmlns viewBox width height fill d]) %></div>
<% end %>

<%= link_to "Back to players", users_path %>
