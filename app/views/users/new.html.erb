<h1>New Player</h1>

<%= form_with model: @user do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.select :status, User::VALID_STATUSES.map { |s| [s.humanize, s] }, include_blank: false %>
  </div>

  <div>
    <%= form.label :qr_code %>
    <%= form.text_area :qr_code %>
  </div>

  <%= form.submit %>
<% end %>

<%= link_to "Back to players", users_path %>
