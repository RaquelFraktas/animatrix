<h1>Scan QR to initialize player</h1>

<%= form_with url: scan_path, method: :post do |form| %>
  <div>
    <%= form.label :qr_code, "QR code value" %>
    <%= form.text_field :qr_code, placeholder: "Paste scanned code here" %>
  </div>

  <%= form.submit "Initialize player" %>
<% end %>

<%= link_to "Back to players", users_path %>
