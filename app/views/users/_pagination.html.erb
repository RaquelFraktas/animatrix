<nav class="<%= css_class %>" aria-label="<%= label %>">
  <%= link_to "‹ Prev", url_for(page: @page - 1) if @page > 1 %>
  <% (1..@total_pages).each do |page| %>
    <% if page == @page %>
      <span aria-current="page"><%= page %></span>
    <% else %>
      <%= link_to page, url_for(page: page) %>
    <% end %>
  <% end %>
  <%= link_to "Next ›", url_for(page: @page + 1) if @page < @total_pages %>
</nav>
