<footer>
  <% if controller.controller_name == "highscores" %>
    <%= link_to "Back to all players", users_path %>
  <% else %>
    <hr>
    <% if current_user %>
      <span style="font-size: .9rem;">Signed in as</span> <%= link_to(current_user&.name, current_user) %></span>
      <br><br>
      <%= button_to logout_path, method: :delete, class: "matrix btn" do %>
        Sign out
        <div class="code-rain"></div>
      <% end %>
    <% else %>
      <%= link_to "Sign in", login_path unless controller.controller_name == "sessions" %>
      <br>
    <% end %>
    <br>
    <%= link_to "Back to players", users_path %>
    <%= link_to "Back to FAQ", root_path %>
  <% end %>

  <p class="disclaimer">
    IF ANYONE <span style="color: #ff0000;">HARASSES</span> OR <span style="color: #ff0000;">TOUCHES</span> YOU INAPPROPRIATELY
    <br>
    <span style="color:#0ff416;">NOTIFY STAFF</span>
    <br>
    THEY WILL BE PERMANENTLY <span style="color: #ff0000;">UNPLUGGED</span> FROM THE PARTY
    NO QUESTIONS ASKED!
  </p>
  <br><br>
  <span style="font-size: .5rem;">Game by <%= link_to "Raquel Fraktas :)", "https://raquel.world", style:"font-size: .5rem;" %> for Grace</span>
</footer>
